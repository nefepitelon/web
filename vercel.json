{
  "buildCommand": "npm run build -- --webpack",
  "regions": [
    "sin1"
  ],
  "functions": {
    "app/.well-known/workflow/v1/step/route.js": {
      "maxDuration": 300
    },
    "api/hedge_*.py": {
      "maxDuration": 300,
      "includeFiles": "hedge-ops/{release.json,cloud_worker.py,gateway.py,account_views.py,emergency.py,network.py,paired_hedge/**,binance_lighter/**,engines/{lighter,entropy}/src/**}",
      "excludeFiles": "{**/node_modules/**,.next/**,artifacts/**,public/**,**/.venv/**,hedge-ops/**/tests/**,.runtime/**}"
    },
    "api/alpha-scan.js": {
      "maxDuration": 60
    },
    "api/telegram-signal-collector.js": {
      "maxDuration": 60,
      "regions": [
        "iad1"
      ]
    },
    "api/aicoin-pulse-collector.js": {
      "maxDuration": 60
    },
    "api/surf-pulse.js": {
      "maxDuration": 60
    },
    "api/cost-basis.js": {
      "maxDuration": 60
    },
    "api/cycle-seasons.js": {
      "maxDuration": 60
    },
    "api/market-heatmap.js": {
      "maxDuration": 60
    },
    "api/address-balance-history.js": {
      "maxDuration": 60
    },
    "api/rplr-m.js": {
      "maxDuration": 60
    },
    "api/lth-sth-ratio.js": {
      "maxDuration": 60
    },
    "api/lth-market-cap-loss.js": {
      "maxDuration": 60
    },
    "api/supply-profit-loss-ratio.js": {
      "maxDuration": 60
    },
    "api/risk-engine.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/stm-hunt/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/aicoin-pulse-collector",
      "schedule": "*/10 * * * *"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
