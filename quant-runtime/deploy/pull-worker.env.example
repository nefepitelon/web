# Website URL must match the trusted URL in the one-time pairing object.
QUANT_APPLICATION_URL=https://ai.welinkbtc.xyz
QUANT_WORKER_ID=device-REPLACE-WITH-YOUR-PAIRED-DEVICE-ID
QUANT_WORKER_TOKEN=REPLACE-WITH-ONE-TIME-PAIRING-TOKEN
QUANT_RUNTIME_ROOT=/srv/welink-quant
QUANT_DOCKER_NETWORK=welink-quant
# Both worker and native gateway gates remain off by default. Pairing never enables live.
QUANT_WORKER_ALLOW_LIVE=false
QUANT_ALLOW_LIVE=false
