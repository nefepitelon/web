# ═══════════════════════════════════════════════════════════
# 可配置多交易所网格机器人 · 配置文件
# 复制本文件为 .env 并填入对应值
# ═══════════════════════════════════════════════════════════

# 服务端口（默认 8080）
PORT=8080

# 模拟账户初始余额 USDC（paper 模式共用）
PAPER_BALANCE=10000

# ── 同类型交易所多账号 ────────────────────────────────────
# 通常无需手工填写：在总览卡片点“复制交易所（多账号）”后自动维护。
# 每种交易所最多 3 个账号；基础账号始终启用，新增账号默认 paper 且不会复制密钥。
# 示例：启用 Decibel 账号 2、Binance 账号 2/3
# EXCHANGE_INSTANCES=de2,bn2,bn3
EXCHANGE_INSTANCES=
# 新账号的模式/网络变量会自动使用“编号在前”的形式，例如 BN2_MODE、BN2_NETWORK；
# 账号与 API 字段使用末尾编号，例如 BINANCE_API_KEY_2、BINANCE_API_SECRET_2。
# 代理按交易所类型共享（所有 Binance 账号共用 BINANCE_PROXY），其余账户字段彼此独立。

# ── 代理 / IP 配置 ────────────────────────────────────────
# 全局代理：直连和独立代理都失败时使用的最低优先级兜底通道
# 启动后会检测并报告各目标连通性，但网络告警不会阻止进入控制台修复配置
# 支持格式：
#   HTTP(S):  http://127.0.0.1:7890
#   SOCKS5:   socks5://127.0.0.1:1080
#   带认证:   socks5://user:pass@host:port
#   简写格式: host:port:user:pass
GLOBAL_PROXY=direct           # direct=全局通道使用本机直连；不会继承系统 HTTP(S)_PROXY

# 各交易所独立代理：直连失败后尝试，仍失败才使用 GLOBAL_PROXY
DECIBEL_PROXY=
EXTENDED_PROXY=
RISEX_PROXY=
BINANCE_PROXY=
ONDO_PROXY=
PHOENIX_PROXY=
NADO_PROXY=
ARCUS_PROXY=
ENTROPY_PROXY=

# ── Decibel 交易所 ────────────────────────────────────────
# 运行模式：paper（模拟）| live（实盘）
DE_MODE=paper
# 网络：mainnet | testnet
DE_NETWORK=mainnet

# 实盘凭据（DE_MODE=live 时必填）
# API Key：在 geomi.dev 创建
DECIBEL_API_KEY=
# API 钱包 Ed25519 私钥：在 app.decibel.trade/api 创建
# 该 API Wallet Address 还需持有 APT 支付挂单/撤单 gas（不是 Trading Account）
DECIBEL_PRIVATE_KEY=
# Trading Account 地址
DECIBEL_SUBACCOUNT=
# 连续链上交易间隔，避免节点限流/nonce 冲突
DECIBEL_ORDER_GAP_MS=500
# 自定义 API URL（留空使用默认）
DECIBEL_API_URL=

# ── Extended 交易所 ───────────────────────────────────────
EX_MODE=paper
EX_NETWORK=mainnet

# 实盘凭据（EX_MODE=live 时必填）
# 在 app.extended.exchange → API Management 获取
EXTENDED_API_KEY=
EXTENDED_VAULT=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
# 手续费安全上限；实际 maker/taker 费率会从 /api/v1/user/fees 自动读取
EXTENDED_MAX_FEE=0.0005
EXTENDED_ORDER_GAP_MS=400
EXTENDED_API_URL=

# ── RISEx 交易所 ──────────────────────────────────────────
RS_MODE=paper
RS_NETWORK=mainnet

# 实盘凭据（RS_MODE=live 时必填）
ACCOUNT_ADDRESS=
SIGNER_PRIVATE_KEY=
RISEX_ORDER_GAP_MS=300
RISEX_API_URL=
RISEX_WS_URL=

# ── Binance USDⓈ-M Futures ─────────────────────────────────
# 默认 paper 仅模拟成交；行情仍使用 Binance 公开永续合约行情
BN_MODE=paper
# mainnet | testnet（建议先在 testnet 验证）
BN_NETWORK=mainnet

# 实盘凭据（BN_MODE=live 时必填）
# 在 Binance API Management 创建专用 Key：启用 Futures 交易，不启用提现
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 签名有效窗口，官方最大 60000；推荐保留 5000
BINANCE_RECV_WINDOW=5000
BINANCE_ORDER_GAP_MS=200
# 自定义 USDⓈ-M Futures REST 地址（留空使用官方默认）
BINANCE_API_URL=

# ── Ondo Perps（股票 / ETF / 加密资产永续）───────────────────
# 默认 paper + sandbox；公开标记价格来自 Ondo Perps，成交在本地模拟
ONDO_MODE=paper
# mainnet | testnet（testnet 对应官方 sandbox，建议先验证完整流程）
ONDO_NETWORK=testnet
# 实盘凭据（ONDO_MODE=live 时必填）：账户菜单 → API Keys → Add New API Key
ONDO_KEY_ID=
ONDO_API_SECRET=
ONDO_POLL_MS=3000
# Ondo 批量下单单批最多 20 单；该值控制批次与账户写请求间隔
ONDO_ORDER_GAP_MS=1200
# 自定义 REST / WebSocket 地址（留空使用当前网络的官方地址）
ONDO_API_URL=
ONDO_WS_URL=

# ── Phoenix（Solana 永续合约）───────────────────────────────
# paper 使用 Phoenix 官方真实行情、本机模拟成交；live 由专用钱包本机签名上链
PHOENIX_MODE=paper
PHOENIX_NETWORK=mainnet
# 实盘二选一：直接填写专用钱包私钥，或填写本机 Solana keypair JSON 路径
PHOENIX_PRIVATE_KEY=
PHOENIX_KEYPAIR_PATH=secrets/phoenix.key
PHOENIX_API_URL=https://perp-api.phoenix.trade
PHOENIX_SOLANA_RPC=https://api.mainnet-beta.solana.com
# 连续链上写入间隔与 Compute Unit 上限
PHOENIX_ORDER_GAP_MS=1200
PHOENIX_CU_LIMIT=600000
# 可选：交易所专属策略约束；留空使用页面策略参数
PHOENIX_LEVERAGE=
PHOENIX_HALF_BAND=

# ── Nado（Ink L2 永续合约）─────────────────────────────────
# paper 使用 Nado 官方真实行情、本机模拟成交；live 通过 EIP-712 在本机签名
NADO_MODE=paper
NADO_NETWORK=mainnet
# 实盘二选一：32 字节 Hex 专用交易私钥，或本机私钥文件路径
NADO_PRIVATE_KEY=
NADO_KEY_PATH=secrets/nado.key
# Linked Signer 模式填写主账户地址；私钥就是账户钱包时可留空自动推导
NADO_ADDRESS=
NADO_SUBACCOUNT=default
# 官方 BTC-PERP 产品号；其余市场由 symbols 接口动态发现
NADO_BTC_PRODUCT_ID=2
# Ink RPC 与连续订单写入间隔
NADO_INK_RPC=https://rpc-gel.inkonchain.com
NADO_ORDER_GAP_MS=200
# 可选：交易所专属策略杠杆上限；留空使用页面策略参数
NADO_LEVERAGE=

# ── OKX USDⓈ 永续合约 ─────────────────────────────────────
# paper 仅本地模拟成交；testnet 会在 live 时使用 OKX Demo Trading 请求头
OKX_MODE=paper
OKX_NETWORK=testnet
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_ORDER_GAP_MS=200
OKX_POLL_MS=3000
OKX_API_URL=https://www.okx.com

# ── GRVT L2 永续合约 ──────────────────────────────────────
# live 需要 Trade API Key、专用 EIP-712 交易签名私钥和数字 Sub Account ID
GRVT_MODE=paper
GRVT_NETWORK=testnet
GRVT_API_KEY=
GRVT_PRIVATE_KEY=
GRVT_SUB_ACCOUNT_ID=
GRVT_ORDER_GAP_MS=250
GRVT_POLL_MS=4000
# 留空会按网络自动使用官方 market-data / trades / edge 地址
GRVT_MARKET_URL=
GRVT_TRADE_URL=
GRVT_AUTH_URL=

# ── Arcus（Robinhood Chain 永续；Perps Beta）────────────────
# paper 使用 Arcus 官方公开实时行情、本机模拟成交。
# live 仅适用于已获 Perps Beta 权限且所在地区符合 Arcus 条款的用户。
AR_MODE=paper
AR_NETWORK=mainnet
# 以下仅 AR_MODE=live 时使用。ARCUS_ADDRESS 是公开地址，绝不能填写主钱包私钥或助记词。
ARCUS_ADDRESS=
ARCUS_ACCOUNT_INDEX=0
# Ed25519 API 公钥，以及与它配对的 API Signing Key；Signing Key 不是 Ethereum 钱包私钥。
ARCUS_API_KEY=
# Signing Key 二选一：直接填写，或推荐使用本机文件。
ARCUS_API_PRIVATE_KEY=
ARCUS_API_PRIVATE_KEY_FILE=secrets/arcus-private.pem
ARCUS_GOOD_TIL_DAYS=40
# 无法读取账户实际费率时的保守回退值
ARCUS_FEE_RATE=0.0005
# 留空按 AR_NETWORK 使用官方 REST / WebSocket；不要填写第三方镜像。
ARCUS_API_URL=
ARCUS_WS_URL=

# ── Entropy（Hyperliquid HIP-3；仅 PAPER）───────────────────
# 当前接入只从 Hyperliquid 官方 API 读取 Entropy 真实行情，在本机模拟成交。
# LIVE 明确禁用；无需也不得在本项目中填写主钱包或 Agent/API Wallet 私钥。
ENTROPY_MODE=paper
ENTROPY_NETWORK=mainnet
# Entropy 官方 HIP-3 DEX 标识固定为 io；市场名由官方 meta 动态发现（例如 io:ANTH）。
ENTROPY_DEX=io
# 官方 API 基地址，程序在其后调用 /info；不要在这里追加 /info。
ENTROPY_API_URL=https://api.hyperliquid.xyz

# ── Robinhood Chain Lighter（RHC）──────────────────────────
# RHC 当前固定官方 mainnet；live 使用官方 Python signer 在本机签名
LR_MODE=paper
LR_NETWORK=mainnet
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
# 二选一；推荐仅在本机文件中保存单行 API 私钥
LIGHTER_API_PRIVATE_KEY=
LIGHTER_API_PRIVATE_KEY_FILE=secrets/lighter-api-private-key.txt
# 留空由一键启动选择/准备 64 位 Python 3.12
LIGHTER_PYTHON=
LIGHTER_FEE_RATE=0.0005
LIGHTER_ORDER_GAP_MS=300

# 新增交易所独立代理：仍遵循 本机直连 → 独立代理 → GLOBAL_PROXY
OKX_PROXY=
GRVT_PROXY=
LIGHTER_PROXY=

# ── AI 助手（可选：风控哨兵/日报/市况分析/对话操控/出区间建议）──
# 协议类型：openai | anthropic | gemini
#   openai = 所有 OpenAI 兼容服务（OpenAI/DeepSeek/Kimi/通义/智谱/OpenRouter/Ollama 等）
AI_PROVIDER=openai
AI_API_KEY=
# 接口地址（留空用官方默认）。示例：
#   DeepSeek: https://api.deepseek.com/v1    Kimi: https://api.moonshot.cn/v1
#   通义: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama 本地: http://127.0.0.1:11434/v1
AI_BASE_URL=
# AI 专用代理（可选）：直连失败后的第二通道；仍失败才使用 GLOBAL_PROXY。
# 代理商标注“支持 HTTPS”通常仍应填写 http://（HTTP CONNECT）；仅明确提供 TLS 代理端口时才用 https://。
# 不论是否填写，AI 都会先检测本机直连。
AI_PROXY=
# 主模型（复盘/分析/对话）与小模型（哨兵巡检，高频省钱，可留空同主模型）
AI_MODEL=
AI_MODEL_SMALL=
# 哨兵巡检间隔（分钟，0=关闭）；BTC 市况报告间隔（分钟，0=关闭）；日报生成时间（0-23 整点）
AI_SENTINEL_MINUTES=5
AI_MARKET_MINUTES=30
AI_REPORT_HOUR=20

# 通知推送（可选，配了才会推）：Telegram 机器人 + 通用 Webhook（POST {"text":...}）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=
