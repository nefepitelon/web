generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  PRIVY
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
}

enum CryptoPaymentStatus {
  PENDING
  CONFIRMING
  PAID
  FAILED
  EXPIRED
  REVIEW
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAYABLE
  PAID
  VOID
}

enum WlbTransactionType {
  DEPOSIT
  TRANSFER
  WITHDRAWAL
  COMMISSION
  REWARD
  ADJUSTMENT
}

enum WlbTransactionStatus {
  PENDING
  CONFIRMING
  COMPLETED
  REJECTED
  FAILED
  EXPIRED
}

enum WalletChain {
  EVM
  SOLANA
}

enum ResearchArticleStatus {
  DRAFT
  PUBLISHED
}

enum ResearchArticleAccess {
  PUBLIC
  FREE
  PRO
  MAX
}

enum ResearchArticleSource {
  INTERNAL
  EXTERNAL
}

enum AlphaExecutionMode {
  PAPER
  MOCK_EXCHANGE
  TESTNET
  LIVE
}

enum AlphaMarketType {
  SPOT
  FUTURES
}

enum AlphaExecutionState {
  CREATED
  NORMALIZED
  DEDUPE_CHECKED
  RISK_REJECTED
  RISK_APPROVED
  PLANNED
  AWAITING_CONFIRMATION
  EXECUTING
  SUBMITTED
  PARTIALLY_FILLED
  FILLED
  PROTECTION_ACTIVE
  MONITORING
  RECONCILING
  RECONCILED
  CANCELED
  CLOSED
  KILLED
  FAILED
  UNKNOWN
}

enum AlphaOrderStatus {
  PENDING
  SUBMITTED
  NEW
  PARTIALLY_FILLED
  FILLED
  CANCELED
  REJECTED
  EXPIRED
  UNKNOWN
}

enum AlphaOrderRole {
  ENTRY
  STOP_LOSS
  TAKE_PROFIT
  CLOSE
}

enum ResearchCommentStatus {
  PUBLISHED
  HIDDEN
}

model User {
  id                          String                   @id @db.Uuid
  email                       String                   @unique
  emailVerifiedAt             DateTime?
  status                      UserStatus               @default(ACTIVE)
  lastLoginAt                 DateTime?
  privyUserId                 String?                  @unique
  embeddedWalletId            String?                  @unique
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  profile                     Profile?
  authAccounts                AuthAccount[]
  roles                       UserRole[]
  subscriptions               Subscription[]
  cryptoPayments              CryptoPayment[]
  socialAccounts              SocialAccount[]
  wallets                     Wallet[]
  walletChallenges            WalletChallenge[]
  twoFactor                   TwoFactorSetting?
  backupCodes                 BackupCode[]
  referralCodes               ReferralCode[]
  referralsMade               Referral[]               @relation("ReferralReferrer")
  referralReceived            Referral?                @relation("ReferralReferred")
  commissionsEarned           CommissionLedger[]       @relation("CommissionReferrer")
  commissionsCreated          CommissionLedger[]       @relation("CommissionReferred")
  auditLogs                   AuditLog[]               @relation("AuditActor")
  apiKeys                     ApiKey[]
  researchArticles            ResearchArticle[]        @relation("ResearchAuthor")
  researchBookmarks           ResearchBookmark[]
  researchComments            ResearchComment[]
  accessRedemptions           AccessCodeRedemption[]
  toolboxFavorites            ToolboxFavorite[]
  alphaTradingCredentials     AlphaTradingCredential[]
  alphaExecutionConfig        AlphaExecutionConfig?
  alphaAutomationConfig       AlphaAutomationConfig?
  alphaAutomationOrders       AlphaAutomationOrder[]
  alphaTradeIntents           AlphaTradeIntent[]
  alphaExecutionPlans         AlphaExecutionPlan[]
  alphaTradingOrders          AlphaTradingOrder[]
  alphaTradingPositions       AlphaTradingPosition[]
  alphaTradingAudits          AlphaTradingAudit[]
  tideSightTradingCredentials TideSightTradingCredential[]
  tideSightExecutionConfig TideSightExecutionConfig?
  tideSightTradeIntents TideSightTradeIntent[]
  tideSightExecutionPlans TideSightExecutionPlan[]
  tideSightTradingOrders TideSightTradingOrder[]
  tideSightTradingPositions TideSightTradingPosition[]
  tideSightTradingAudits TideSightTradingAudit[]
  tideSightAutoEvents TideSightAutoEvent[]
  classicGridBot              ClassicGridBot?
  hostedGridOpsBot            HostedGridOpsBot?
  hostedGridOpsCommands       HostedGridOpsCommand[]
  quantSuiteInstances         QuantSuiteInstance[]
  quantSuiteCommands          QuantSuiteCommand[]
  quantSuiteDevices           QuantSuiteDevice[]
  onboardingTasks             UserOnboardingTask[]
  analyticsEvents             AnalyticsEvent[]
  wlbAccount                  WlbAccount?
  wlbOwnedTransactions        WlbTransaction[]         @relation("WlbTransactionOwner")
  wlbCounterpartyTransactions WlbTransaction[]         @relation("WlbTransactionCounterparty")
  wlbLedgerEntries            WlbLedgerEntry[]
  chainTransactionClaims      ChainTransactionClaim[]

  @@map("users")
}

model ClassicGridBot {
  id              String    @id @default(cuid())
  userId          String    @unique @db.Uuid
  configEncrypted String    @db.Text
  configSummary   Json
  dryRun          Boolean   @default(true)
  paused          Boolean   @default(false)
  status          String    @default("STOPPED") @db.VarChar(24)
  runId           String?   @db.VarChar(160)
  snapshot        Json?
  lastError       String?   @db.VarChar(2000)
  heartbeatAt     DateTime?
  startedAt       DateTime?
  stoppedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, heartbeatAt])
  @@map("classic_grid_bots")
}

model HostedGridOpsBot {
  id              String                 @id @default(cuid())
  userId          String                 @unique @db.Uuid
  configEncrypted String                 @db.Text
  configSummary   Json
  status          String                 @default("STOPPED") @db.VarChar(24)
  runId           String?                @db.VarChar(160)
  snapshot        Json?
  marketCatalog   Json?
  lastError       String?                @db.VarChar(2000)
  heartbeatAt     DateTime?
  startedAt       DateTime?
  stoppedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  commands        HostedGridOpsCommand[]

  @@index([status, heartbeatAt])
  @@map("hosted_grid_ops_bots")
}

model HostedGridOpsCommand {
  id          String           @id @default(cuid())
  botId       String
  userId      String           @db.Uuid
  type        String           @db.VarChar(48)
  target      String?          @db.VarChar(48)
  payload     Json?
  status      String           @default("PENDING") @db.VarChar(24)
  result      Json?
  error       String?          @db.VarChar(2000)
  createdAt   DateTime         @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  bot         HostedGridOpsBot @relation(fields: [botId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([botId, status, createdAt])
  @@index([userId, createdAt])
  @@map("hosted_grid_ops_commands")
}

model AlphaAutomationConfig {
  userId           String   @id @db.Uuid
  settings         Json
  version          String
  enabled          Boolean  @default(false)
  status           String   @default("STOPPED")
  generation       String?
  grantFingerprint String?
  market           String   @default("futures")
  startedAt        DateTime?
  expiresAt        DateTime?
  lastScanAt       DateTime?
  nextScanAt       DateTime?
  lastOrderAt      DateTime?
  heartbeatAt      DateTime?
  lastError        String?
  runId            String?
  leaseToken       String?
  leaseUntil       DateTime?
  submissionToken  String?
  submissionUntil  DateTime?
  dailyBaseline    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AlphaAutomationOrder {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  generation       String
  cycleKey         String
  symbol           String
  side             String
  status           String   @default("RESERVED")
  candidate        Json
  notional         Float
  planId           String?  @unique
  closeAfter       DateTime
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, generation, cycleKey, symbol])
  @@index([userId, status, createdAt])
}

model AlphaTradingCredential {
  id                 String              @id @default(cuid())
  userId             String              @db.Uuid
  environment        AlphaExecutionMode
  market             AlphaMarketType
  label              String              @default("Binance")
  apiKeyEncrypted    String              @db.Text
  apiSecretEncrypted String              @db.Text
  proxyEncrypted     String?             @db.Text
  apiKeyHint         String
  enabled            Boolean             @default(true)
  verifiedAt         DateTime?
  permissionSummary  Json?
  lastError          String?             @db.VarChar(1000)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             AlphaTradingOrder[]

  @@unique([userId, environment, market])
  @@index([userId, enabled])
  @@map("alpha_trading_credentials")
}

model AlphaExecutionConfig {
  id                        String             @id @default(cuid())
  userId                    String             @unique @db.Uuid
  activeMode                AlphaExecutionMode @default(PAPER)
  defaultMarket             AlphaMarketType    @default(FUTURES)
  testnetEnabled            Boolean            @default(false)
  liveEnabled               Boolean            @default(false)
  autoExecuteEnabled        Boolean            @default(false)
  killSwitchActive          Boolean            @default(false)
  requireManualConfirmation Boolean            @default(true)
  requireProtectionOrders   Boolean            @default(true)
  riskPerTradePct           Float              @default(0.75)
  maxLeverage               Int                @default(3)
  dailyLossLimitPct         Float              @default(2)
  dedupeWindowMinutes       Int                @default(15)
  maxOpenPositions          Int                @default(6)
  maxPortfolioExposurePct   Float              @default(50)
  minAlphaScore             Int                @default(75)
  perOrderNotionalLimit     Float              @default(50)
  dailyNotionalLimit        Float              @default(200)
  liveUnlockedAt            DateTime?
  liveUnlockedBy            String?            @db.Uuid
  lastReconciledAt          DateTime?
  reconciliationHealthy     Boolean            @default(true)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alpha_execution_configs")
}

model AlphaTradeIntent {
  id              String              @id @default(cuid())
  userId          String              @db.Uuid
  environment     AlphaExecutionMode
  market          AlphaMarketType
  symbol          String
  side            String
  orderType       String              @default("MARKET")
  entryPrice      Float
  stopLoss        Float
  takeProfit      Float
  leverage        Int                 @default(1)
  riskPct         Float
  source          String
  alphaScore      Float?
  dedupeHash      String
  state           AlphaExecutionState @default(CREATED)
  rejectionReason String?             @db.VarChar(2000)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            AlphaExecutionPlan?
  audits          AlphaTradingAudit[]

  @@index([userId, symbol, side, createdAt])
  @@index([userId, state, createdAt])
  @@index([dedupeHash, createdAt])
  @@map("alpha_trade_intents")
}

model AlphaExecutionPlan {
  id               String                @id @default(cuid())
  intentId         String                @unique
  userId           String                @db.Uuid
  environment      AlphaExecutionMode
  market           AlphaMarketType
  state            AlphaExecutionState   @default(PLANNED)
  mainOrder        Json
  protectionOrders Json
  riskSnapshot     Json
  safeguards       Json
  expiresAt        DateTime
  confirmedAt      DateTime?
  executedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  intent           AlphaTradeIntent      @relation(fields: [intentId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders           AlphaTradingOrder[]
  position         AlphaTradingPosition?
  audits           AlphaTradingAudit[]

  @@index([userId, state, createdAt])
  @@map("alpha_execution_plans")
}

model AlphaTradingOrder {
  id               String                  @id @default(cuid())
  userId           String                  @db.Uuid
  planId           String
  credentialId     String?
  environment      AlphaExecutionMode
  market           AlphaMarketType
  role             AlphaOrderRole
  symbol           String
  side             String
  orderType        String
  quantity         Float
  price            Float?
  stopPrice        Float?
  clientOrderId    String
  idempotencyKey   String                  @unique
  exchangeOrderId  String?
  status           AlphaOrderStatus        @default(PENDING)
  filledQuantity   Float                   @default(0)
  averagePrice     Float?
  rawResponse      Json?
  errorMessage     String?                 @db.VarChar(2000)
  lastReconciledAt DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             AlphaExecutionPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  credential       AlphaTradingCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  audits           AlphaTradingAudit[]

  @@unique([userId, environment, market, clientOrderId])
  @@index([userId, status, createdAt])
  @@index([planId, role])
  @@map("alpha_trading_orders")
}

model AlphaTradingPosition {
  id               String              @id @default(cuid())
  userId           String              @db.Uuid
  planId           String              @unique
  environment      AlphaExecutionMode
  market           AlphaMarketType
  symbol           String
  side             String
  quantity         Float
  entryPrice       Float
  markPrice        Float?
  stopLoss         Float
  takeProfit       Float
  unrealizedPnl    Float               @default(0)
  state            AlphaExecutionState @default(MONITORING)
  lastReconciledAt DateTime?
  openedAt         DateTime            @default(now())
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             AlphaExecutionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, state, openedAt])
  @@map("alpha_trading_positions")
}

model AlphaTradingAudit {
  id        String              @id @default(cuid())
  userId    String              @db.Uuid
  intentId  String?
  planId    String?
  orderId   String?
  state     AlphaExecutionState
  status    String
  message   String              @db.VarChar(2000)
  metadata  Json?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  intent    AlphaTradeIntent?   @relation(fields: [intentId], references: [id], onDelete: Cascade)
  plan      AlphaExecutionPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  order     AlphaTradingOrder?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([planId, createdAt])
  @@map("alpha_trading_audits")
}

model TideSightTradingCredential {
  id                 String              @id @default(cuid())
  userId             String              @db.Uuid
  environment        AlphaExecutionMode
  market             AlphaMarketType
  label              String              @default("Binance")
  apiKeyEncrypted    String              @db.Text
  apiSecretEncrypted String              @db.Text
  proxyEncrypted     String?             @db.Text
  apiKeyHint         String
  enabled            Boolean             @default(true)
  verifiedAt         DateTime?
  permissionSummary  Json?
  lastError          String?             @db.VarChar(1000)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             TideSightTradingOrder[]

  @@unique([userId, environment, market])
  @@index([userId, enabled])
  @@map("tidesight_trading_credentials")
}

model TideSightExecutionConfig {
  id                        String             @id @default(cuid())
  userId                    String             @unique @db.Uuid
  activeMode                AlphaExecutionMode @default(PAPER)
  defaultMarket             AlphaMarketType    @default(FUTURES)
  testnetEnabled            Boolean            @default(false)
  liveEnabled               Boolean            @default(false)
  autoExecuteEnabled        Boolean            @default(false)
  killSwitchActive          Boolean            @default(false)
  requireManualConfirmation Boolean            @default(true)
  requireProtectionOrders   Boolean            @default(true)
  riskPerTradePct           Float              @default(1.5)
  maxLeverage               Int                @default(25)
  dailyLossLimitPct         Float              @default(2)
  dedupeWindowMinutes       Int                @default(15)
  maxOpenPositions          Int                @default(6)
  maxPortfolioExposurePct   Float              @default(50)
  minTideSightScore             Int                @default(75)
  perOrderNotionalLimit     Float              @default(1000)
  dailyNotionalLimit        Float              @default(5000)
  liveUnlockedAt            DateTime?
  liveUnlockedBy            String?            @db.Uuid
  lastReconciledAt          DateTime?
  reconciliationHealthy     Boolean            @default(false)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  autoGeneration            String?
  autoRunId                 String?
  autoStartedAt             DateTime?
  autoHeartbeatAt           DateTime?
  autoError                 String? @db.VarChar(2000)
  autoStopLossPct            Float?
  autoTakeProfitPct          Float?
  executionLeaseToken       String?
  executionLeaseUntil       DateTime?

  @@map("tidesight_execution_configs")
}

model TideSightTradeIntent {
  id              String              @id @default(cuid())
  userId          String              @db.Uuid
  environment     AlphaExecutionMode
  market          AlphaMarketType
  symbol          String
  side            String
  orderType       String              @default("MARKET")
  entryPrice      Float
  stopLoss        Float
  takeProfit      Float
  leverage        Int                 @default(1)
  riskPct         Float
  source          String
  tideSightScore      Float?
  dedupeHash      String
  state           AlphaExecutionState @default(CREATED)
  rejectionReason String?             @db.VarChar(2000)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            TideSightExecutionPlan?
  audits          TideSightTradingAudit[]

  @@index([userId, symbol, side, createdAt])
  @@index([userId, state, createdAt])
  @@index([dedupeHash, createdAt])
  @@map("tidesight_trade_intents")
}

model TideSightExecutionPlan {
  id               String                @id @default(cuid())
  intentId         String                @unique
  userId           String                @db.Uuid
  environment      AlphaExecutionMode
  market           AlphaMarketType
  state            AlphaExecutionState   @default(PLANNED)
  mainOrder        Json
  protectionOrders Json
  riskSnapshot     Json
  safeguards       Json
  expiresAt        DateTime
  confirmedAt      DateTime?
  executedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  intent           TideSightTradeIntent      @relation(fields: [intentId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders           TideSightTradingOrder[]
  position         TideSightTradingPosition?
  audits           TideSightTradingAudit[]

  @@index([userId, state, createdAt])
  @@map("tidesight_execution_plans")
}

model TideSightTradingOrder {
  id               String                  @id @default(cuid())
  userId           String                  @db.Uuid
  planId           String
  credentialId     String?
  environment      AlphaExecutionMode
  market           AlphaMarketType
  role             AlphaOrderRole
  symbol           String
  side             String
  orderType        String
  quantity         Float
  price            Float?
  stopPrice        Float?
  clientOrderId    String
  idempotencyKey   String                  @unique
  exchangeOrderId  String?
  status           AlphaOrderStatus        @default(PENDING)
  filledQuantity   Float                   @default(0)
  averagePrice     Float?
  rawResponse      Json?
  errorMessage     String?                 @db.VarChar(2000)
  lastReconciledAt DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             TideSightExecutionPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  credential       TideSightTradingCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  audits           TideSightTradingAudit[]

  @@unique([userId, environment, market, clientOrderId])
  @@index([userId, status, createdAt])
  @@index([planId, role])
  @@map("tidesight_trading_orders")
}

model TideSightTradingPosition {
  id               String              @id @default(cuid())
  userId           String              @db.Uuid
  planId           String              @unique
  environment      AlphaExecutionMode
  market           AlphaMarketType
  symbol           String
  side             String
  quantity         Float
  entryPrice       Float
  markPrice        Float?
  stopLoss         Float
  takeProfit       Float
  unrealizedPnl    Float               @default(0)
  state            AlphaExecutionState @default(MONITORING)
  lastReconciledAt DateTime?
  openedAt         DateTime            @default(now())
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             TideSightExecutionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, state, openedAt])
  @@map("tidesight_trading_positions")
}

model TideSightTradingAudit {
  id        String              @id @default(cuid())
  userId    String              @db.Uuid
  intentId  String?
  planId    String?
  orderId   String?
  state     AlphaExecutionState
  status    String
  message   String              @db.VarChar(2000)
  metadata  Json?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  intent    TideSightTradeIntent?   @relation(fields: [intentId], references: [id], onDelete: Cascade)
  plan      TideSightExecutionPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  order     TideSightTradingOrder?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([planId, createdAt])
  @@map("tidesight_trading_audits")
}

model TideSightAutoEvent {
  id         String @id @default(cuid())
  userId     String @db.Uuid
  eventKey   String @unique
  strategyId String
  symbol     String
  interval   String
  closedAt   DateTime
  status     String @default("CLAIMED")
  planId     String?
  message    String? @db.VarChar(2000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("tidesight_auto_events")
}

model ToolboxCategory {
  id          String        @id @default(cuid())
  name        String
  description String?
  color       String        @default("#4BA3D8")
  sortOrder   Int           @default(0)
  isPublic    Boolean       @default(true)
  isCollapsed Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       ToolboxItem[]

  @@index([sortOrder])
  @@map("toolbox_categories")
}

model ToolboxItem {
  id           String             @id @default(cuid())
  categoryId   String
  name         String
  description  String?            @db.VarChar(1000)
  officialUrl  String?
  loginAccount String?            @db.VarChar(1000)
  isPublished  Boolean            @default(false)
  rating       Int?
  financing    String?
  tutorial     String?            @db.VarChar(2000)
  isPublic     Boolean            @default(true)
  rowColor     String             @default("none")
  sortOrder    Int                @default(0)
  createdBy    String?            @db.Uuid
  updatedBy    String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  category     ToolboxCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cells        ToolboxCellValue[]
  favorites    ToolboxFavorite[]

  @@index([categoryId, sortOrder])
  @@index([isPublic, isPublished])
  @@map("toolbox_items")
}

model ToolboxColumn {
  id          String             @id @default(cuid())
  key         String             @unique
  title       String
  type        String             @default("text")
  width       Int                @default(160)
  sortOrder   Int                @default(0)
  isSystem    Boolean            @default(false)
  isVisible   Boolean            @default(true)
  isPublic    Boolean            @default(true)
