  contractAddress   String    @db.VarChar(42)
  multiplier        String    @db.VarChar(100)
  quantity          String    @db.VarChar(100)
  costUsd           Decimal   @db.Decimal(30, 10)
  highPrice         Decimal   @db.Decimal(30, 10)
  strategy          String    @db.VarChar(32)
  entryOrderId      String    @db.VarChar(64)
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())

  @@unique([ownerKey, symbol])
  @@map("bstock_auto_positions")
}

model BstockAutoEvent {
  id                String    @id @default(cuid())
  ownerKey          String    @db.VarChar(64)
  generation        String?   @db.VarChar(64)
  kind              String    @db.VarChar(32)
  status            String?   @db.VarChar(32)
  symbol            String?   @db.VarChar(32)
  side              String?   @db.VarChar(8)
  strategy          String?   @db.VarChar(32)
  reason            String    @db.VarChar(2000)
  orderId           String?   @db.VarChar(128)
  txHash            String?   @db.VarChar(200)
  metadata          Json?
  createdAt         DateTime  @default(now())

  @@index([ownerKey, createdAt])
  @@map("bstock_auto_events")
}

model QuantSuiteInstance {
  id              String   @id @default(cuid())
  userId          String   @db.Uuid
  engine          String
  config          Json
  revision        Int      @default(1)
  controlSequence Int      @default(0)
  activeCommandId String?
  cachedRuntime   Json?
  runtimeObservedAt DateTime?
  runtimeWorkerId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, engine])
  @@map("quant_suite_instances")
}

model QuantSuiteCommand {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  engine      String
  action      String
  requestId   String
  payloadHash String
  status      String   @default("PENDING")
  result      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispatch    QuantSuiteDispatch?

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@map("quant_suite_commands")
}

model QuantSuiteDispatch {
  id                  String   @id @default(cuid())
  commandId           String   @unique
  userId              String   @db.Uuid
  engine              String
  action              String
  requestId           String
  controlSequence     Int
  revision            Int
  configHash          String
  expectedVersion     String
  payload             Json
  status              String   @default("QUEUED")
  workerId            String?
  leaseTokenHash      String?
  leaseExpiresAt      DateTime?
  expiresAt           DateTime
  dispatchedAt        DateTime?
  completedAt         DateTime?
  result              Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  command             QuantSuiteCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@index([workerId, status, createdAt])
  @@index([userId, engine, status])
  @@index([status, leaseExpiresAt])
  @@map("quant_suite_dispatches")
}

model QuantSuiteWorker {
  id              String   @id
  protocolVersion Int      @default(1)
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("quant_suite_workers")
}

model QuantSuiteDevice {
  id        String    @id
  userId    String    @db.Uuid
  name      String
  tokenHash String    @unique
  engines   String[]
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("quant_suite_devices")
}
