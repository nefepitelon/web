    "api/surf-pulse.js": {
      "maxDuration": 60
    },
    "api/surf-research.js": {
      "maxDuration": 300
    },
    "api/cost-basis.js": {
      "maxDuration": 60
    },
    "api/lth-sth-ratio.js": {
