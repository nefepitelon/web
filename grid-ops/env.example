# Portable first-run fallback.
#
# Vercel excludes files whose names begin with `.env` before its remote build.
# Keep this non-secret, non-dotfile template in the downloadable engine so a
# brand-new Windows installation can always create `.env` safely. The control
# console fills every omitted field from the exchange manifest and writes any
# values the user configures later.

PORT=8080
PAPER_BALANCE=10000
EXCHANGE_INSTANCES=
GLOBAL_PROXY=direct

DE_MODE=paper
DE_NETWORK=mainnet
EX_MODE=paper
EX_NETWORK=mainnet
RS_MODE=paper
RS_NETWORK=mainnet
BN_MODE=paper
BN_NETWORK=mainnet
ONDO_MODE=paper
ONDO_NETWORK=testnet
PHOENIX_MODE=paper
PHOENIX_NETWORK=mainnet
NADO_MODE=paper
NADO_NETWORK=mainnet
OKX_MODE=paper
OKX_NETWORK=testnet
GRVT_MODE=paper
GRVT_NETWORK=testnet
LR_MODE=paper
LR_NETWORK=mainnet
