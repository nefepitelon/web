{
  "name": "welinkbtc-main",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "hedge:setup": "node scripts/hedge-ops.mjs setup",
    "hedge:package": "node scripts/package-hedge-ops.mjs",
    "hedge:local": "hedge-ops/.venv/Scripts/python.exe hedge-ops/local.py",
    "hedge:start": "node scripts/hedge-ops.mjs start",
    "hedge:test": "node scripts/hedge-ops.mjs test",
    "dev": "node scripts/run-with-grid.mjs dev",
    "build": "npm run hedge:package && npm run grid:package && npm run quant:native && npm run quant:package && prisma generate && node scripts/migrate-on-vercel.mjs && next build",
    "start": "node scripts/run-with-grid.mjs start",
    "postinstall": "npm install --prefix grid-ops --omit=dev && npm install --prefix classic-grid --omit=dev",
    "grid:install": "npm install --prefix grid-ops --omit=dev",
    "grid:package": "node scripts/package-grid-ops-engine.mjs",
    "grid:start": "npm --prefix grid-ops start",
    "grid:smoke": "node scripts/smoke-grid-ops.mjs",
    "grid:test": "npm --prefix grid-ops test",
    "quant:package": "node scripts/package-quant-runtime.mjs",
    "quant:native": "node scripts/package-native-quant-freqtrade.mjs && node scripts/verify-native-quant-assets.mjs",
    "quant:test": "npm --prefix quant-runtime test",
    "classic-grid:test": "npm --prefix classic-grid test",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@bnb-chain/b402": "0.2.1",
    "@pancakeswap/sdk": "^5.9.0",
    "@pancakeswap/smart-router": "^7.6.0",
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "0.10.0",
    "@supabase/supabase-js": "2.100.1",
    "@vercel/blob": "latest",
    "@vercel/functions": "3.9.3",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "bigint-buffer": "file:classic-grid/vendor/bigint-buffer-1.1.6.tgz",
    "cheerio": "^1.1.2",
    "exceljs": "4.4.0",
    "graphql-request": "^5.0.0",
    "jose": "6.1.0",
    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "stripe": "20.4.1",
    "undici": "^6.29.1",
    "viem": "2.55.11",
    "workflow": "^4.8.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "archiver": "5.3.2",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "bigint-buffer": "$bigint-buffer",
    "uuid": "11.1.1",
    "postcss": {
      "nanoid": "3.3.18"
    },
    "@workflow/core": {
      "nanoid": "5.1.16"
    },
    "@workflow/world-local": {
      "undici": "7.30.1"
    },
    "@workflow/world-vercel": {
      "undici": "7.30.1"
    },
    "zod@^4.0.0": "4.6.6",
    "undici@^7.0.0": "7.30.1",
    "piscina@^4.0.0": "4.9.4",
    "proxy-addr": "2.0.8",
    "bn.js@^5.0.0": "5.2.3",
    "ws@^8.0.0": "8.21.2",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^5.0.0": "5.0.12",
    "source-map-js": "1.2.2",
    "devalue@^5.0.0": "5.9.3",
    "sharp": "0.35.5",
    "body-parser@^2.0.0": "2.4.0"
  }
}
