{
  "services": {
    "octobot": {
      "image": "${ENGINE_IMAGE}", "restart": "unless-stopped",
      "ports": ["127.0.0.1:${UI_PORT}:5001"],
      "volumes": ["./project/user:/octobot/user", "tentacles:/octobot/tentacles", "./native/logs:/octobot/logs", "./native/backtesting:/octobot/backtesting"],
      "command": ["--simulate", "--no-telegram"], "stop_grace_period": "60s"
    }
  },
  "volumes": { "tentacles": {} }
}
